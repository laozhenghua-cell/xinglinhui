 "syndromes": [
  {
   "id": "fengre",
   "name": "风热",
   "altName": "",
   "methods": [
    "平肝",
    "泻心"
   ],
   "summary": "外感风邪闭塞腠理，脏腑之热不得宣通；肝木心火相搏而成。治以平肝风、泻心火。",
   "waihou": {
    "original": "凡小儿风热之症，外候身热，唇色深红而亮，或鼻塞，或泻青黄色如浮萍状，或不泻。",
    "plain": "发热；口唇深红而光亮（唇皮软薄血纹易现）；或鼻塞不通；或大便泻下青黄相间、形如浮萍的水样便；也有不泻的。"
   },
   "bingyin": {
    "original": "此症由外感风邪闭塞腠理，脏腑之热不得宣通故身热。唇皮软薄血纹易现，内有风故色亮；内有热，血亦有热，故色深红。风热闭塞肺窍故鼻不通。因肝木色青，泻由脾致，脾土色黄，肝木旺克脾土，故泻青黄色；其或不泻者，是脾土未受肝克，故不泻也。",
    "plain": "风邪郁表、热不得外透则发热；唇薄血络易显，风使色亮、热使色深红；肺窍被风热所闭则鼻塞；肝（青）乘脾（黄）则泻青黄色，脾未受克则不泻。"
   },
   "shouwen": {
    "original": "手纹浮紫，左手纹常浮于右手。左手纹主肝，肝风动故纹浮，浮为风在表也；紫色为热，故纹紫也。",
    "plain": "指纹浮露、颜色紫；左手（肝）指纹常比右手更浮——浮主表、紫主热。"
   },
   "maifa": {
    "original": "脉按之必浮数，脉浮为风、数为热，左手更甚。左手是肝脉主风也，心亦在左手。此是肝风心火相合而成。",
    "plain": "脉浮数，左手更明显（浮主风、数主热，左候肝心）。"
   },
   "zhifa": {
    "original": "治尚平肝风、泻心火，症必早复。",
    "plain": "平熄肝风、清泻心火，病可速愈。"
   },
