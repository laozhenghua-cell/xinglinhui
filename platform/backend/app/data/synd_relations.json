    {"from": "太阳病", "to": "阳明病", "type": "传变", "note": "表证失治入里化热,或汗下太过,津伤化燥", "source": "《伤寒论》六经传变"},
    {"from": "太阳病", "to": "太阴病", "type": "传变", "note": "表证误下或素体脾虚,表邪内陷,损伤脾阳", "source": "《伤寒论》桂枝人参汤证意"},
    {"from": "太阴病", "to": "少阴病", "type": "传变", "note": "太阴虚寒日久,损及肾阳", "source": "《伤寒论》六经传变"},
    {"from": "少阴病", "to": "厥阴病", "type": "传变", "note": "阴寒至极,阴阳气不相顺接", "source": "《伤寒论》六经传变"},
    {"from": "卫分证", "to": "气分证", "type": "传变", "note": "卫分不解,顺传入气", "source": "《温热论》卫气营血传变"},
    {"from": "气分证", "to": "营分证", "type": "传变", "note": "气分热盛不解,内陷营分", "source": "《温热论》"},
    {"from": "营分证", "to": "血分证", "type": "传变", "note": "营热不解,深入血分,动血耗血", "source": "《温热论》"},
    {"from": "肝气郁结", "to": "肝火上炎", "type": "转化", "note": "气郁日久化火", "source": "《中医基础理论》"},
    {"from": "肝火上炎", "to": "肝阳上亢", "type": "转化", "note": "火盛伤阴,阴不制阳,阳亢于上", "source": "《中医基础理论》"},
    {"from": "肝阳上亢", "to": "肝风内动", "type": "转化", "note": "阳亢化风,风阳上扰", "source": "《中医基础理论》"},
    {"from": "脾气虚", "to": "脾阳虚", "type": "转化", "note": "气虚日久及阳", "source": "《中医基础理论》"},
    {"from": "脾阳虚", "to": "肾阳虚", "type": "转化", "note": "脾病及肾,久则火不暖土、脾肾两虚", "source": "《中医基础理论》"},
    {"from": "寒湿困脾", "to": "湿热蕴脾", "type": "转化", "note": "湿郁日久化热", "source": "《中医基础理论》"},
    {"from": "风寒束肺", "to": "痰湿阻肺", "type": "转化", "note": "寒伤肺气,宣降失司,津聚成痰", "source": "《中医基础理论》"},
    {"from": "肺气虚", "to": "脾气虚", "type": "相兼", "note": "子病及母,肺脾两虚,治当培土生金", "source": "《中医基础理论》"},
    {"from": "脾气虚", "to": "肺气虚", "type": "相兼", "note": "土不生金,肺脾两虚", "source": "《中医基础理论》"},
    {"from": "心气虚", "to": "心阳虚", "type": "转化", "note": "气虚及阳(心阳虚衰则见肢冷脉微)", "source": "《中医基础理论》"}
  ]
