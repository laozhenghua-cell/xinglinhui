# Application
APP_NAME=痔漏辅助诊疗系统
APP_ENV=development

# Database（生产环境务必修改为强密码）
DATABASE_URL=postgresql+asyncpg://zhilou_user:CHANGE_ME_DB_PASSWORD@localhost:5432/zhilou_db

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT：必须用强随机密钥（可执行 `python -c "import secrets; print(secrets.token_urlsafe(48))"` 生成）
SECRET_KEY=CHANGE_ME_STRONG_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS

# CORS：允许的跨域来源（逗号分隔），生产环境改为自己的域名
CORS_ORIGINS=http://localhost:8080,http://localhost:8088

# DeepSeek AI (text-based syndrome differentiation)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# Qwen VL (multimodal image analysis)
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max

# File uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# Sentry (optional)
SENTRY_DSN=

# Trial period
TRIAL_DAYS=30
