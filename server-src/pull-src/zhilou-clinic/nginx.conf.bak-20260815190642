upstream backend {
    server backend:8000;
}

upstream frontend {
    server frontend:80;
}

# gzip 压缩
gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_comp_level 6;
gzip_types text/plain text/css application/json application/javascript text/javascript application/xml application/xml+rss image/svg+xml;

# HTTP -> HTTPS 重定向（保留 ACME 校验）
server {
    listen 80;
    server_name zl.llixz.cn;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS 主站
server {
    listen 443 ssl;
    http2 on;
    server_name zl.llixz.cn;

    ssl_certificate /etc/letsencrypt/live/zl.llixz.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/zl.llixz.cn/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets on;

    # 安全响应头
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 20M;

    # 静态资源（带 hash 文件名，可长期缓存）
    location /assets/ {
        proxy_pass http://frontend;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # 前端其它静态文件（图标等）
    location ~* \.(svg|png|jpg|jpeg|ico|woff|woff2|ttf)$ {
        proxy_pass http://frontend;
        expires 30d;
        add_header Cache-Control "public";
    }

    # API -> 后端
    location /api/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # 上传文件
    location /uploads/ {
        proxy_pass http://backend;
        proxy_set_header Host $host;
    }

    # 前端 SPA（html 不缓存，保证更新及时）
    location / {
        proxy_pass http://frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        add_header Cache-Control "no-cache";
    }
}

# ===== 中医外科疮疡辅助诊疗系统 (cy.llixz.cn) =====
server {
    listen 80;
    server_name cy.llixz.cn;

    root /usr/share/nginx/html/tcm-surgery;
    index index.html;
    client_max_body_size 20M;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://172.17.0.1:8010;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }

    location /uploads/ {
        proxy_pass http://172.17.0.1:8010;
        proxy_set_header Host $host;
    }
}
